    <!-- Firebase SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, deleteDoc, updateDoc, doc, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyDE2rJWMYdFawA6D9AzZUEy_XPIMVfmdMo",
            authDomain: "barbearia-eliseu---2.firebaseapp.com",
            projectId: "barbearia-eliseu---2",
            storageBucket: "barbearia-eliseu---2.firebasestorage.app",
            messagingSenderId: "667974163346",
            appId: "1:667974163346:web:d76c3a00ac96248922bf4b"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        window.db = db;
        window.col = collection;
        window.addDoc = addDoc;
        window.getDocs = getDocs;
        window.deleteDoc = deleteDoc;
        window.updateDoc = updateDoc;
        window.doc = doc;
        window.onSnapshot = onSnapshot;

        window.dispatchEvent(new CustomEvent('firebase-pronto'));
    </script>

    <script>
        function barbeariaApp() {
            return {
                aba: 'atendimento',
                statusCliente: 'Novo',
                
                listaServicos: [],
                produtosDisponiveis: [],
                historico: [],
                mensalistas: [],
                agendamentos: [],
                listaFechamentos: [],
                
                form: {
                    dataHora: '', telefone: '', nome: '', servicoId: 0,
                    produtosSelecionados: [], desconto: 0, pagamento: 'Pix', total: 0
                },

                // Modal Concluir Agendamento
                modalConcluirAberto: false,
                agendamentoParaConcluir: {},
                conclusaoForm: {
                    servicoId: 0,
                    produtosSelecionados: [],
                    pagamento: 'Pix',
                    desconto: 0
                },
                
                // Modal de Fechamento de Período
                modalFechamentoAberto: false,
                dadosFechamento: {
                    nomePeriodo: '',
                    totalRecebido: 0,
                    qtdCortes: 0,
                    produtosVendidos: 0,
                    nomes: []
                },

                novoMensalista: { nome: '', whatsapp: '', tipo: '', limiteSemanal: 4 },
                novoServico: { nome: '', preco: 0 },
                novoProduto: { nome: '', preco: 0 },
                novoAgendamento: { clienteSelecionado: '', cliente: '', whats: '', data: '', hora: '', freq: 1 },

                modalAlertaAberto: false,
                clienteAlerta: { nome: '', hora: '', whats: '' },
                alertasNotificados: [],

                init() {
                    this.atualizarDataHora();
                    setInterval(() => this.atualizarDataHora(), 1000);
                    
                    this.$watch('form.servicoId', () => this.atualizarTotal());
                    this.$watch('form.produtosSelecionados', () => this.atualizarTotal());
                    this.$watch('form.desconto', () => this.atualizarTotal());

                    window.addEventListener('firebase-pronto', () => {
                        this.carregarDadosTempoReal();
                    });

                    setInterval(() => {
                        this.checarAlertaAgendamentos();
                    }, 10000);
                },

                carregarDadosTempoReal() {
                    window.onSnapshot(window.col(window.db, 'historico'), (snapshot) => {
                        this.historico = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                        this.historico.sort((a, b) => b.id - a.id);
                    });

                    window.onSnapshot(window.col(window.db, 'fechamentos'), (snapshot) => {
                        this.listaFechamentos = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                        this.listaFechamentos.sort((a, b) => new Date(b.dataFechamento) - new Date(a.dataFechamento));
                    });

                    window.onSnapshot(window.col(window.db, 'mensalistas'), (snapshot) => {
                        this.mensalistas = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                    });

                    window.onSnapshot(window.col(window.db, 'agendamentos'), (snapshot) => {
                        this.agendamentos = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                        this.checarAlertaAgendamentos();
                        this.limparAgendamentosVencidos();
                    });

                    window.onSnapshot(window.col(window.db, 'servicos'), (snapshot) => {
                        const servicosTemp = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                        if (servicosTemp.length === 0) {
                            this.adicionarServicoPadrao('Corte Degradê', 40.00);
                            this.adicionarServicoPadrao('Barba', 25.00);
                            this.adicionarServicoPadrao('Corte + Barba', 60.00);
                        } else {
                            this.listaServicos = servicosTemp;
                        }
                    });

                    window.onSnapshot(window.col(window.db, 'produtos'), (snapshot) => {
                        const produtosTemp = snapshot.docs.map(d => ({ docId: d.id, ...d.data() }));
                        if (produtosTemp.length === 0) {
                            this.adicionarProdutoPadrao('Pomada', 25.00);
                            this.adicionarProdutoPadrao('Gel', 25.00);
                            this.adicionarProdutoPadrao('Minoxidil', 60.00);
                        } else {
                            this.produtosDisponiveis = produtosTemp;
                        }
                    });
                },

                // FUNÇÃO QUE LIMPA OS DIAS PASSADOS DA AGENDA E MANDA PRO HISTÓRICO
                async limparAgendamentosVencidos() {
                    const hoje = new Date();
                    hoje.setHours(0, 0, 0, 0); // Zera as horas para comparar apenas os dias

                    for (let a of this.agendamentos) {
                        if (!a.data) continue;
                        const [ano, mes, dia] = a.data.split('-');
                        const dataAg = new Date(ano, mes - 1, dia);

                        if (dataAg < hoje) {
                            // Enviar para o histórico informando que foi encerrado automaticamente (não compareceu/não finalizado no sistema)
                            await window.addDoc(window.col(window.db, 'historico'), {
                                id: Date.now(),
                                dataHora: a.data.split('-').reverse().join('/') + ' ' + a.hora + ' (Passado)',
                                nome: a.cliente,
                                telefone: a.whats || 'Não informado',
                                servicoNome: 'Dia Encerrado',
                                produtosNomes: 'Nenhum',
                                pagamento: '-',
                                visitas: a.freq || 1,
                                total: 0
                            });
                            // Apagar da agenda ativa
                            await window.deleteDoc(window.doc(window.db, 'agendamentos', a.docId));
                        }
                    }
                },

                // FUNÇÕES DO FECHAMENTO DE PERÍODO
                abrirModalFechamento() {
                    let totalDinheiro = 0;
                    let qtdCortes = 0;
                    let produtosVendidos = 0;
                    let clientesSet = new Set();
                    
                    this.historico.forEach(h => {
                        totalDinheiro += h.total;
                        if (h.servicoNome !== 'Dia Encerrado') qtdCortes += 1;
                        if (h.produtosNomes && h.produtosNomes !== 'Nenhum') produtosVendidos += 1;
                        if (h.servicoNome !== 'Dia Encerrado') {
                            clientesSet.add(h.nome + ' (' + (h.telefone || 'Sem número') + ') - ' + (h.pagamento || ''));
                        }
                    });
                    
                    this.dadosFechamento = {
                        nomePeriodo: '',
                        totalRecebido: totalDinheiro,
                        qtdCortes: qtdCortes,
                        produtosVendidos: produtosVendidos,
                        nomes: Array.from(clientesSet)
                    };
                    
                    this.modalFechamentoAberto = true;
                },

                async confirmarFechamento() {
                    if (!this.dadosFechamento.nomePeriodo) {
                        alert("Por favor, dê um nome para este período (Ex: 'Mês de Maio' ou 'Semana 1').");
                        return;
                    }

                    // Salva a consolidação na nova coleção fechamentos
                    await window.addDoc(window.col(window.db, 'fechamentos'), {
                        nomePeriodo: this.dadosFechamento.nomePeriodo,
                        dataFechamento: new Date().toISOString(),
                        totalRecebido: this.dadosFechamento.totalRecebido,
                        qtdCortes: this.dadosFechamento.qtdCortes,
                        produtosVendidos: this.dadosFechamento.produtosVendidos,
                        nomes: this.dadosFechamento.nomes
                    });

                    // Limpa todo o histórico atual um por um
                    for (let h of this.historico) {
                        await window.deleteDoc(window.doc(window.db, 'historico', h.docId));
                    }

                    this.modalFechamentoAberto = false;
                    alert('Período encerrado, arquivado em "Fechamentos" e histórico limpo com sucesso!');
                    this.aba = 'fechamentos';
                },

                async removerFechamento(docId) {
                    if (confirm('Atenção: Tem certeza que deseja apagar este relatório de fechamento?')) {
                        await window.deleteDoc(window.doc(window.db, 'fechamentos', docId));
                    }
                },

                async adicionarServicoPadrao(nome, preco) {
                    await window.addDoc(window.col(window.db, 'servicos'), { id: Date.now(), nome, preco });
                },

                async adicionarProdutoPadrao(nome, preco) {
                    await window.addDoc(window.col(window.db, 'produtos'), { nome, preco });
                },

                atualizarDataHora() {
                    const agora = new Date();
                    this.form.dataHora = agora.toLocaleDateString('pt-BR') + ' ' + agora.toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'});
                },

                buscarCliente() {
                    const telLimpo = this.form.telefone.replace(/\D/g, '');
                    if (telLimpo.length < 8) { this.statusCliente = 'Novo'; return; }
                    
                    const encontrado = this.historico.find(h => h.telefone && h.telefone.replace(/\D/g, '') === telLimpo);
                    if (encontrado) {
                        this.form.nome = encontrado.nome;
                        this.statusCliente = 'Cadastrado';
                    } else {
                        this.statusCliente = 'Novo';
                    }
                },

                atualizarTotal() {
                    let servicoObj = this.listaServicos.find(s => s.id === this.form.servicoId);
                    let servicoVal = servicoObj ? parseFloat(servicoObj.preco) : 0;
                    
                    let produtosVal = this.form.produtosSelecionados.reduce((acc, nomeProduto) => {
                        let prod = this.produtosDisponiveis.find(p => p.nome === nomeProduto);
                        return acc + (prod ? parseFloat(prod.preco) : 0);
                    }, 0);

                    let descontoVal = parseFloat(this.form.desconto) || 0;
                    let totalCalc = (servicoVal + produtosVal) - descontoVal;
                    
                    this.form.total = totalCalc > 0 ? totalCalc : 0;
                },

                async salvarAtendimento() {
                    if (!this.form.nome || this.form.servicoId === 0) {
                        alert('Preencha o nome e selecione um serviço principal!');
                        return;
                    }

                    let servicoObj = this.listaServicos.find(s => s.id === this.form.servicoId);
                    const telLimpo = this.form.telefone.replace(/\D/g, '');
                    const visitas = this.historico.filter(h => h.telefone && h.telefone.replace(/\D/g, '') === telLimpo).length + 1;

                    const novoRegistro = {
                        id: Date.now(),
                        dataHora: this.form.dataHora,
                        nome: this.form.nome,
                        telefone: this.form.telefone,
                        servicoNome: servicoObj.nome,
                        produtosNomes: this.form.produtosSelecionados.length > 0 ? this.form.produtosSelecionados.join(', ') : 'Nenhum',
                        pagamento: this.form.pagamento,
                        visitas: visitas,
                        total: this.form.total
                    };

                    await window.addDoc(window.col(window.db, 'historico'), novoRegistro);

                    this.form.telefone = ''; this.form.nome = ''; this.form.servicoId = 0;
                    this.form.produtosSelecionados = []; this.form.desconto = 0;
                    this.form.pagamento = 'Pix'; 
                    this.statusCliente = 'Novo';
                    
                    alert('Atendimento salvo e sincronizado na nuvem!');
                },

                async removerHistorico(docId) {
                    if (confirm('Deseja realmente excluir este atendimento?')) {
                        await window.deleteDoc(window.doc(window.db, 'historico', docId));
                    }
                },

                // ---- AGENDAMENTOS E QUADRADOS DE CALENDÁRIO ----
                preencherDadosMensalista() {
                    if (!this.novoAgendamento.clienteSelecionado) return;
                    let m = this.mensalistas.find(x => x.nome === this.novoAgendamento.clienteSelecionado);
                    if (m) {
                        this.novoAgendamento.cliente = m.nome;
                        this.novoAgendamento.whats = m.whatsapp;
                    }
                },

                async salvarAgendamento() {
                    if(!this.novoAgendamento.cliente || !this.novoAgendamento.data || !this.novoAgendamento.hora) {
                        alert('Preencha o nome, data e horário!');
                        return;
                    }

                    const horarioDuplicado = this.agendamentos.find(a => a.data === this.novoAgendamento.data && a.hora === this.novoAgendamento.hora);
                    if (horarioDuplicado) {
                        alert('⚠️ Atenção: O horário de ' + this.novoAgendamento.hora + ' do dia ' + this.novoAgendamento.data.split('-').reverse().join('/') + ' já foi agendado para o cliente ' + horarioDuplicado.cliente + '!');
                        return;
                    }

                    await window.addDoc(window.col(window.db, 'agendamentos'), { 
                        cliente: this.novoAgendamento.cliente,
                        whats: this.novoAgendamento.whats,
                        data: this.novoAgendamento.data,
                        hora: this.novoAgendamento.hora,
                        freq: this.novoAgendamento.freq 
                    });

                    this.novoAgendamento = { clienteSelecionado: '', cliente: '', whats: '', data: '', hora: '', freq: 1 };
                    alert('Agendamento salvo com sucesso!');
                },

                abrirModalConcluir(agendamento) {
                    this.agendamentoParaConcluir = agendamento;
                    this.conclusaoForm = {
                        servicoId: 0,
                        produtosSelecionados: [],
                        pagamento: 'Pix',
                        desconto: 0
                    };
                    this.modalConcluirAberto = true;
                },

                calcularTotalConclusao() {
                    let servicoObj = this.listaServicos.find(s => s.id === this.conclusaoForm.servicoId);
                    let servicoVal = servicoObj ? parseFloat(servicoObj.preco) : 0;

                    let produtosVal = this.conclusaoForm.produtosSelecionados.reduce((acc, nomeProduto) => {
                        let prod = this.produtosDisponiveis.find(p => p.nome === nomeProduto);
                        return acc + (prod ? parseFloat(prod.preco) : 0);
                    }, 0);

                    let descontoVal = parseFloat(this.conclusaoForm.desconto) || 0;
                    let totalCalc = (servicoVal + produtosVal) - descontoVal;
                    return totalCalc > 0 ? totalCalc : 0;
                },

                async confirmarConclusaoAgendamento() {
                    if (this.conclusaoForm.servicoId === 0) {
                        alert('Selecione o serviço/corte realizado!');
                        return;
                    }

                    let servicoObj = this.listaServicos.find(s => s.id === this.conclusaoForm.servicoId);
                    const agora = new Date();
                    const dataHoraFormatada = agora.toLocaleDateString('pt-BR') + ' ' + agora.toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'});

                    const novoRegistro = {
                        id: Date.now(),
                        dataHora: dataHoraFormatada,
                        nome: this.agendamentoParaConcluir.cliente,
                        telefone: this.agendamentoParaConcluir.whats || 'Não informado',
                        servicoNome: servicoObj.nome,
                        produtosNomes: this.conclusaoForm.produtosSelecionados.length > 0 ? this.conclusaoForm.produtosSelecionados.join(', ') : 'Nenhum',
                        pagamento: this.conclusaoForm.pagamento,
                        visitas: this.agendamentoParaConcluir.freq || 1,
                        total: this.calcularTotalConclusao()
                    };

                    await window.addDoc(window.col(window.db, 'historico'), novoRegistro);
                    await window.deleteDoc(window.doc(window.db, 'agendamentos', this.agendamentoParaConcluir.docId));

                    this.modalConcluirAberto = false;
                    alert('Atendimento concluído e transferido para o histórico com sucesso!');
                },

                obterProximosDias() {
                    const dias = [];
                    const diasSemanaNomes = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
                    
                    for (let i = 0; i < 30; i++) {
                        const d = new Date();
                        d.setDate(d.getDate() + i);
                        
                        const ano = d.getFullYear();
                        const mes = String(d.getMonth() + 1).padStart(2, '0');
                        const dia = String(d.getDate()).padStart(2, '0');
                        const dataStr = `${ano}-${mes}-${dia}`;

                        const agendamentosDoDia = this.agendamentos
                            .filter(a => a.data === dataStr)
                            .sort((a, b) => a.hora.localeCompare(b.hora));

                        let tooltipText = `Data: ${dia}/${mes}/${ano}\n`;
                        if (agendamentosDoDia.length === 0) {
                            tooltipText += "Nenhum horário agendado.";
                        } else {
                            tooltipText += "Horários agendados:\n" + agendamentosDoDia.map(a => `• ${a.hora} - ${a.cliente}`).join('\n');
                        }

                        dias.push({
                            dataStr: dataStr,
                            diaSemana: i === 0 ? 'Hoje' : diasSemanaNomes[d.getDay()],
                            diaMes: `${dia}/${mes}`,
                            total: agendamentosDoDia.length,
                            tooltipHorarios: tooltipText
                        });
                    }
                    return dias;
                },

                obterClasseCorDia(total) {
                    if (total >= 1 && total <= 3) {
                        return 'bg-emerald-50 border-emerald-300 text-emerald-900';
                    } else if (total >= 4 && total <= 5) {
                        return 'bg-amber-50 border-amber-300 text-amber-900';
                    } else if (total >= 6) {
                        return 'bg-red-50 border-red-300 text-red-900';
                    } else {
                        return 'bg-zinc-50 border-zinc-200 text-zinc-500';
                    }
                },

                checarAlertaAgendamentos() {
                    const agora = new Date();
                    this.agendamentos.forEach(a => {
                        if (!a.data || !a.hora) return;
                        const [ano, mes, dia] = a.data.split('-');
                        const [hora, min] = a.hora.split(':');
                        const dataAgendada = new Date(ano, mes - 1, dia, hora, min);

                        const difMinutos = (dataAgendada - agora) / (1000 * 60);

                        if (difMinutos > 0 && difMinutos <= 15 && !this.alertasNotificados.includes(a.docId)) {
                            this.clienteAlerta = { nome: a.cliente, hora: a.hora, whats: a.whats };
                            this.modalAlertaAberto = true;
                            this.alertasNotificados.push(a.docId);
                        }
                    });
                },

                fecharAlerta() {
                    this.modalAlertaAberto = false;
                },

                // ---- MENSALISTAS ----
                atualizarLimitePlano() {
                    if (this.novoMensalista.tipo.includes('100')) {
                        this.novoMensalista.limiteSemanal = 4;
                    } else if (this.novoMensalista.tipo.includes('160')) {
                        this.novoMensalista.limiteSemanal = 4;
                    }
                },

                contarVisitasMensalistaNaSemana(nomeMensalista) {
                    const hoje = new Date();
                    const inicioSemana = new Date(hoje);
                    inicioSemana.setDate(hoje.getDate() - hoje.getDay());
                    inicioSemana.setHours(0,0,0,0);

                    let count = this.agendamentos.filter(a => {
                        if (a.cliente.toLowerCase() !== nomeMensalista.toLowerCase()) return false;
                        if (!a.data) return false;
                        const [ano, mes, dia] = a.data.split('-');
                        const dataAg = new Date(ano, mes - 1, dia);
                        return dataAg >= inicioSemana;
                    }).length;

                    return count;
                },

                async salvarMensalista() {
                    if(!this.novoMensalista.nome || !this.novoMensalista.tipo) return;
                    await window.addDoc(window.col(window.db, 'mensalistas'), {
                        nome: this.novoMensalista.nome,
                        whatsapp: this.novoMensalista.whatsapp || 'Não informado',
                        tipo: this.novoMensalista.tipo,
                        limiteSemanal: parseInt(this.novoMensalista.limiteSemanal) || 4
                    });
                    this.novoMensalista = { nome: '', whatsapp: '', tipo: '', limiteSemanal: 4 };
                },

                async removerMensalista(docId) {
                    if (confirm('Excluir este mensalista?')) {
                        await window.deleteDoc(window.doc(window.db, 'mensalistas', docId));
                    }
                },

                // ---- CONFIGURAÇÕES ----
                async adicionarServico() {
                    if(!this.novoServico.nome || this.novoServico.preco <= 0) return;
                    await window.addDoc(window.col(window.db, 'servicos'), {
                        id: Date.now(),
                        nome: this.novoServico.nome,
                        preco: parseFloat(this.novoServico.preco)
                    });
                    this.novoServico = { nome: '', preco: 0 };
                },
                async removerServico(docId) {
                    await window.deleteDoc(window.doc(window.db, 'servicos', docId));
                },
                async adicionarProduto() {
                    if(!this.novoProduto.nome || this.novoProduto.preco <= 0) return;
                    await window.addDoc(window.col(window.db, 'produtos'), {
                        nome: this.novoProduto.nome,
                        preco: parseFloat(this.novoProduto.preco)
                    });
                    this.novoProduto = { nome: '', preco: 0 };
                },
                async removerProduto(docId) {
                    await window.deleteDoc(window.doc(window.db, 'produtos', docId));
                }
            }
        }
    </script>
</body>
