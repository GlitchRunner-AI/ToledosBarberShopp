<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestão - Barbearia</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-zinc-100 text-zinc-800 font-sans antialiased" x-data="barbeariaApp()">

    <!-- MODAL POP-UP DE ALERTA (15 MIN ANTES) -->
    <div x-show="modalAlertaAberto" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 p-4" style="display: none;">
        <div class="bg-white rounded-lg shadow-2xl p-6 max-w-sm w-full text-center border-4 border-amber-500">
            <div class="text-amber-500 text-5xl mb-2">⏰</div>
            <h3 class="text-xl font-bold text-zinc-900 mb-1">Próximo Atendimento!</h3>
            <p class="text-sm text-zinc-600 mb-4">Faltam 15 minutos para o horário agendado.</p>
            
            <div class="bg-amber-50 border border-amber-200 rounded p-3 mb-4 text-left">
                <p class="text-sm font-bold text-zinc-800" x-text="'Cliente: ' + clienteAlerta.nome"></p>
                <p class="text-xs text-zinc-600" x-text="'Horário: ' + clienteAlerta.hora + ' hrs'"></p>
                <p class="text-xs text-zinc-600" x-text="'WhatsApp: ' + (clienteAlerta.whats || 'Não informado')"></p>
            </div>

            <button @click="fecharAlerta()" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-2.5 rounded shadow text-sm uppercase tracking-wide">
                Entendido / Fechar
            </button>
        </div>
    </div>

    <!-- MODAL POP-UP AO CONCLUIR AGENDAMENTO -->
    <div x-show="modalConcluirAberto" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 p-4" style="display: none;">
        <div class="bg-white rounded-lg shadow-2xl p-6 max-w-md w-full">
            <h3 class="text-lg font-bold text-zinc-900 mb-1">Finalizar Atendimento</h3>
            <p class="text-sm text-zinc-600 mb-4" x-text="'Cliente: ' + agendamentoParaConcluir.cliente"></p>
            
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Serviço / Corte Desejado</label>
                    <select x-model.number="conclusaoForm.servicoId" class="w-full border border-zinc-300 rounded p-2 text-sm bg-white focus:outline-none">
                        <option value="0">Selecione o serviço...</option>
                        <template x-for="servico in listaServicos" :key="servico.docId">
                            <option :value="servico.id" x-text="servico.nome + ' - R$ ' + servico.preco.toFixed(2)"></option>
                        </template>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">O cliente levou algo adicional?</label>
                    <div class="grid grid-cols-2 gap-2 mt-1">
                        <template x-for="produto in produtosDisponiveis" :key="produto.docId">
                            <label class="flex items-center space-x-2 border border-zinc-200 p-2 rounded text-xs hover:bg-zinc-50 cursor-pointer">
                                <input type="checkbox" :value="produto.nome" x-model="conclusaoForm.produtosSelecionados" class="rounded border-zinc-300 text-zinc-900">
                                <span class="flex-1" x-text="produto.nome + ' (R$ ' + parseFloat(produto.preco).toFixed(2) + ')'"></span>
                            </label>
                        </template>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Forma de Pagamento</label>
                        <select x-model="conclusaoForm.pagamento" class="w-full border border-zinc-300 rounded p-2 text-sm bg-white focus:outline-none">
                            <option value="Pix">Pix</option>
                            <option value="Crédito">Cartão de Crédito</option>
                            <option value="Débito">Cartão de Débito</option>
                            <option value="Dinheiro">Dinheiro</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Desconto (R$)</label>
                        <input type="number" step="0.01" x-model.number="conclusaoForm.desconto" placeholder="0,00" class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                    </div>
                </div>

                <div class="bg-zinc-900 text-white p-3 rounded flex justify-between items-center">
                    <span class="text-xs uppercase tracking-wider">Valor Total da Comanda</span>
                    <span class="text-xl font-bold" x-text="'R$ ' + calcularTotalConclusao().toFixed(2)"></span>
                </div>
            </div>

            <div class="flex justify-end space-x-2">
                <button @click="modalConcluirAberto = false" class="bg-zinc-200 hover:bg-zinc-300 text-zinc-800 px-4 py-2 rounded text-sm font-medium">Cancelar</button>
                <button @click="confirmarConclusaoAgendamento()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded text-sm font-bold shadow-sm">Confirmar e Enviar</button>
            </div>
        </div>
    </div>

    <!-- MODAL POP-UP DE ENCERRAMENTO DE PERÍODO -->
    <div x-show="modalFechamentoAberto" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4" style="display: none;">
        <div class="bg-white rounded-lg shadow-2xl p-6 max-w-lg w-full">
            <h3 class="text-xl font-bold text-zinc-900 mb-1">Encerrar Período (Dia/Semana/Mês)</h3>
            <p class="text-sm text-red-600 font-medium mb-4">Atenção: Ao confirmar, todo o "Histórico de Atendimentos" atual será limpo e arquivado nesta totalização.</p>
            
            <div class="bg-zinc-50 border border-zinc-200 rounded p-4 mb-4">
                <div class="grid grid-cols-2 gap-4 text-sm mb-4">
                    <div>
                        <span class="block text-xs text-zinc-500 uppercase">Total Arrecadado</span>
                        <span class="font-bold text-lg text-emerald-600" x-text="'R$ ' + dadosFechamento.totalRecebido.toFixed(2)"></span>
                    </div>
                    <div>
                        <span class="block text-xs text-zinc-500 uppercase">Serviços Prestados</span>
                        <span class="font-bold text-lg text-zinc-800" x-text="dadosFechamento.qtdCortes + ' cortes/serviços'"></span>
                    </div>
                    <div>
                        <span class="block text-xs text-zinc-500 uppercase">Itens Adicionais</span>
                        <span class="font-bold text-lg text-zinc-800" x-text="dadosFechamento.produtosVendidos + ' itens'"></span>
                    </div>
                </div>

                <div class="border-t border-zinc-200 pt-3 max-h-32 overflow-y-auto">
                    <span class="block text-xs text-zinc-500 uppercase mb-2">Clientes Atendidos neste período:</span>
                    <ul class="text-xs text-zinc-700 space-y-1">
                        <template x-for="nome in dadosFechamento.nomes" :key="nome">
                            <li x-text="'- ' + nome"></li>
                        </template>
                        <template x-if="dadosFechamento.nomes.length === 0">
                            <li>Nenhum cliente no histórico.</li>
                        </template>
                    </ul>
                </div>
            </div>

            <div class="mb-4">
                <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Nomeie este período (Ex: Dia 10/05 ou Mês de Maio)</label>
                <input type="text" x-model="dadosFechamento.nomePeriodo" class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none" placeholder="Ex: Semana 1 de Junho">
            </div>

            <div class="flex justify-end space-x-2 mt-4">
                <button @click="modalFechamentoAberto = false" class="bg-zinc-200 hover:bg-zinc-300 text-zinc-800 px-4 py-2 rounded text-sm font-medium">Cancelar</button>
                <button @click="confirmarFechamento()" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded text-sm font-bold shadow-sm">Arquivar e Limpar Histórico</button>
            </div>
        </div>
    </div>

    <!-- Header / Navegação -->
    <header class="bg-zinc-900 text-zinc-100 shadow">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center overflow-x-auto">
            <h1 class="text-lg font-semibold tracking-wide whitespace-nowrap mr-4">Gestão de Barbearia</h1>
            <nav class="flex space-x-1 sm:space-x-2">
                <button @click="aba = 'atendimento'" :class="aba === 'atendimento' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Atendimento</button>
                <button @click="aba = 'agendamentos'" :class="aba === 'agendamentos' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Agendamentos</button>
                <button @click="aba = 'historico'" :class="aba === 'historico' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Histórico</button>
                <button @click="aba = 'fechamentos'" :class="aba === 'fechamentos' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Fechamentos</button>
                <button @click="aba = 'mensalistas'" :class="aba === 'mensalistas' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Mensalistas</button>
                <button @click="aba = 'configuracoes'" :class="aba === 'configuracoes' ? 'bg-zinc-700' : 'bg-transparent hover:bg-zinc-800'" class="px-3 py-1.5 rounded text-sm transition whitespace-nowrap">Configurações</button>
            </nav>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-6">

        <!-- ABA 1: ATENDIMENTO / COMANDA RÁPIDA -->
        <section x-show="aba === 'atendimento'" class="space-y-4">
            
            <!-- Botão de Encerrar Período no topo do Atendimento -->
            <div class="flex justify-end">
                <button @click="abrirModalFechamento()" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2.5 rounded shadow-sm text-sm font-bold tracking-wide flex items-center gap-2">
                    <span>🛑</span> Encerrar Período (Dia/Semana)
                </button>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-zinc-200">
                <h2 class="text-xl font-medium text-zinc-900 mb-4 border-b pb-2">Comanda Rápida</h2>
                
                <form @submit.prevent="salvarAtendimento" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Data e Hora</label>
                            <input type="text" x-model="form.dataHora" readonly class="w-full bg-zinc-50 border border-zinc-300 rounded p-2 text-sm text-zinc-600">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Telefone / WhatsApp</label>
                            <input type="text" x-model="form.telefone" @input="buscarCliente" placeholder="(00) 00000-0000" required class="w-full border border-zinc-300 rounded p-2 text-sm focus:ring-1 focus:ring-zinc-900 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Nome do Cliente</label>
                            <div class="flex items-center space-x-2">
                                <input type="text" x-model="form.nome" placeholder="Nome do Cliente" required class="w-full border border-zinc-300 rounded p-2 text-sm focus:ring-1 focus:ring-zinc-900 focus:outline-none">
                                <span x-text="statusCliente" :class="statusCliente === 'Novo' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'" class="text-xs px-2 py-1 rounded font-medium whitespace-nowrap"></span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Serviço Principal</label>
                            <select x-model.number="form.servicoId" class="w-full border border-zinc-300 rounded p-2 text-sm bg-white focus:outline-none">
                                <option value="0">Selecione o serviço...</option>
                                <template x-for="servico in listaServicos" :key="servico.docId">
                                    <option :value="servico.id" x-text="servico.nome + ' - R$ ' + servico.preco.toFixed(2)"></option>
                                </template>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Forma de Pagamento</label>
                            <select x-model="form.pagamento" class="w-full border border-zinc-300 rounded p-2 text-sm bg-white focus:outline-none">
                                <option value="Pix">Pix</option>
                                <option value="Crédito">Cartão de Crédito</option>
                                <option value="Débito">Cartão de Débito</option>
                                <option value="Dinheiro">Dinheiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="pt-2">
                        <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Produtos / Extras (Selecione à vontade)</label>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                            <template x-for="(produto) in produtosDisponiveis" :key="produto.docId">
                                <label class="flex items-center space-x-2 border border-zinc-200 p-2 rounded text-sm hover:bg-zinc-50 cursor-pointer">
                                    <input type="checkbox" :value="produto.nome" x-model="form.produtosSelecionados" class="rounded border-zinc-300 text-zinc-900 focus:ring-0">
                                    <span class="flex-1 text-xs" x-text="produto.nome + ' (R$ ' + parseFloat(produto.preco).toFixed(2) + ')'"></span>
                                </label>
                            </template>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-zinc-100">
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Desconto (R$)</label>
                            <input type="number" step="0.01" x-model.number="form.desconto" placeholder="0,00" class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                    </div>

                    <div class="flex justify-between items-center bg-zinc-900 text-white p-4 rounded mt-4">
                        <span class="text-sm uppercase tracking-wider">Total da Comanda</span>
                        <span class="text-2xl font-bold" x-text="'R$ ' + form.total.toFixed(2)"></span>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded text-sm font-bold transition shadow-sm w-full md:w-auto uppercase tracking-wide">
                            Salvar Atendimento
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- ABA 2: AGENDAMENTOS -->
        <section x-show="aba === 'agendamentos'" class="space-y-6" style="display: none;">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-zinc-200">
                <h2 class="text-xl font-medium text-zinc-900 mb-4 border-b pb-2">Agendar Cliente & Frequência</h2>
                
                <form @submit.prevent="salvarAgendamento" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Cliente / Mensalista</label>
                            <select x-model="novoAgendamento.clienteSelecionado" @change="preencherDadosMensalista()" class="w-full border border-zinc-300 rounded p-2 text-sm bg-white focus:outline-none mb-2">
                                <option value="">-- Cliente Avulso ou Selecionar Mensalista --</option>
                                <template x-for="m in mensalistas" :key="m.docId">
                                    <option :value="m.nome" x-text="m.nome + ' (Plano: ' + m.tipo + ')'"></option>
                                </template>
                            </select>
                            <input type="text" x-model="novoAgendamento.cliente" placeholder="Nome Completo" required class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">WhatsApp</label>
                            <input type="text" x-model="novoAgendamento.whats" placeholder="(00) 00000-0000" class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Data</label>
                            <input type="date" x-model="novoAgendamento.data" required class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Horário</label>
                            <input type="time" x-model="novoAgendamento.hora" required class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-zinc-500 uppercase mb-1">Frequência Acumulada</label>
                            <input type="number" x-model.number="novoAgendamento.freq" min="1" value="1" class="w-full border border-zinc-300 rounded p-2 text-sm focus:outline-none">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded text-sm font-bold uppercase transition">
                            Salvar Agendamento
                        </button>
                    </div>
                </form>
            </div>

            <!-- QUADRADOS DE CALENDÁRIO COM HOVER TOOLTIP (ATUALIZADO PARA 30 DIAS) -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-zinc-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 border-b pb-2 gap-2">
                    <div>
                        <h2 class="text-lg font-medium text-zinc-900">Visão Geral dos Próximos 30 Dias</h2>
                        <p class="text-xs text-zinc-500">O calendário atualiza automaticamente e exibe apenas hoje em diante. Dias passados são fechados e enviados ao Histórico.</p>
                    </div>
                    <div class="flex items-center space-x-3 text-xs">
                        <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span><span>1-3</span></span>
                        <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded bg-amber-400 inline-block"></span><span>4-5</span></span>
                        <span class="flex items-center space-x-1"><span class="w-3 h-3 rounded bg-red-500 inline-block"></span><span>6+</span></span>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-7 gap-3 mb-6">
                    <template x-for="diaObj in obterProximosDias()" :key="diaObj.dataStr">
                        <div :class="obterClasseCorDia(diaObj.total)" 
                             :title="diaObj.tooltipHorarios"
                             class="border rounded-lg p-3 flex flex-col justify-between transition shadow-sm cursor-help relative group min-h-[90px]">
                            <div>
                                <span class="text-[10px] font-semibold uppercase tracking-wider block opacity-80" x-text="diaObj.diaSemana"></span>
                                <span class="text-base font-bold block" x-text="diaObj.diaMes"></span>
                            </div>
                            <div class="mt-2 pt-2 border-t border-black border-opacity-10 flex justify-between items-center text-xs">
                                <span class="font-medium text-[11px]" x-text="diaObj.total + ' agend.'"></span>
                                <span class="w-2 h-2 rounded-full" :class="{
                                    'bg-emerald-600': diaObj.total >= 1 && diaObj.total <= 3,
                                    'bg-amber-600': diaObj.total >= 4 && diaObj.total <= 5,
                                    'bg-red-600': diaObj.total >= 6,
                                    'bg-zinc-300': diaObj.total === 0
                                }"></span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Lista de Agendamentos -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-zinc-200">
                <h2 class="text-lg font-medium text-zinc-900 mb-4 border-b pb-2">Agenda Detalhada (Aberto)</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-zinc-600">
                        <thead class="bg-zinc-50 text-xs uppercase text-zinc-500 border-b">
                            <tr>
                                <th class="p-3">Cliente / WhatsApp</th>
                                <th class="p-3">Data e Hora</th>
                                <th class="p-3 text-center">Frequência</th>
                                <th class="p-3 text-right">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="a in agendamentos" :key="a.docId">
                                <tr class="border-b hover:bg-zinc-50">
                                    <td class="p-3 font-medium text-zinc-900">
                                        <span x-text="a.cliente"></span><br>
                                        <span class="text-xs text-zinc-400" x-text="a.whats || 'Sem WhatsApp'"></span>
                                    </td>
                                    <td class="p-3 whitespace-nowrap" x-text="a.data + ' às ' + a.hora"></td>
                                    <td class="p-3 text-center">
                                        <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded text-xs font-bold" x-text="a.freq + 'ª Visita'"></span>
                                    </td>
                                    <td class="p-3 text-right space-x-2">
                                        <button @click="abrirModalConcluir(a)" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded text-xs font-bold">Concluir</button>
                                    </td>
                                </tr>
                            </template>
                            <template x-if="agendamentos.length === 0">
                               <tr><td colspan="4" class="p-4 text-center text-zinc-400">Nenhum agendamento ativo ou pendente.</td></tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ABA 3: HISTÓRICO ATUAL -->
        <section x-show="aba === 'historico'" class="bg-white p-6 rounded-lg shadow-sm border border-zinc-200" style="display: none;">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <h2 class="text-xl font-medium text-zinc-900">Histórico de Atendimentos (Período Atual)</h2>
                <span class="text-xs text-zinc-500">Este histórico será limpo quando você "Encerrar o Período".</span>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-zinc-600">
                    <thead class="bg-zinc-50 text-xs uppercase text-zinc-500 border-b">
                        <tr>
                            <th class="p-3">Data/Hora</th>
                            <th class="p-3">Cliente</th>
                            <th class="p-3">Serviço / Extras</th>
                            <th class="p-3 text-center">Visitas</th>
                            <th class="p-3 text-right">Total</th>
                            <th class="p-3 text-right">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
